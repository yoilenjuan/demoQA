{
  "name": "demoqa-automation",
  "version": "1.0.0",
  "description": "Automated UI testing for DemoQA using Playwright, TypeScript, and Cucumber with POM architecture",
  "main": "index.js",
  "scripts": {
    "test": "cucumber-js src/features/elements.feature --require src/step-definitions/elements.steps.ts --require src/support/hooks.ts --require-module ts-node/register",
    "test:ui": "playwright test --ui",
    "test:debug": "cucumber-js --publish",
    "test:smoke": "cucumber-js --tags '@smoke' src/features/elements.feature --require src/step-definitions/elements.steps.ts --require src/support/hooks.ts --require-module ts-node/register",
    "test:regression": "cucumber-js --tags '@regression' src/features/elements.feature --require src/step-definitions/elements.steps.ts --require src/support/hooks.ts --require-module ts-node/register",
    "test:parallel": "cucumber-js --parallel 2 src/features/elements.feature --require src/step-definitions/elements.steps.ts --require src/support/hooks.ts --require-module ts-node/register",
    "test:report": "allure serve reports/allure-results",
    "test:serenity": "serenity-bdd run --features src/features/**/*.feature --source reports/serenity",
    "clean:reports": "rimraf reports/allure-results reports/serenity reports/screenshots logs",
    "clean:all": "npm run clean:reports && rimraf node_modules package-lock.json",
    "pretest": "npm run clean:reports"
  },
  "keywords": [
    "playwright",
    "typescript",
    "cucumber",
    "bdd",
    "automation",
    "testing"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@cucumber/cucumber": "^10.3.1",
    "@cucumber/pretty-formatter": "^1.0.0",
    "@playwright/test": "^1.43.1",
    "@serenity-js/console-reporter": "^3.18.1",
    "@serenity-js/core": "^3.18.1",
    "@serenity-js/cucumber": "^3.18.1",
    "@serenity-js/playwright": "^3.18.1",
    "@serenity-js/serenity-bdd": "^3.18.1",
    "@types/node": "^18.19.31",
    "@types/winston": "^2.4.4",
    "allure-commandline": "^2.25.0",
    "allure-js-commons": "^2.9.0",
    "allure-playwright": "^2.9.0",
    "dotenv": "^16.4.5",
    "rimraf": "^5.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5",
    "winston": "^3.11.0"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "cucumber": "^6.0.7",
    "uuid": "^9.0.1"
  }
}
