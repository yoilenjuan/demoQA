{
  "name": "demoqa-automation",
  "version": "1.0.0",
  "description": "Automated UI testing for DemoQA using Playwright, TypeScript, and Cucumber with POM architecture",
  "main": "index.js",
  "scripts": {
    "test": "cucumber-js",
    "test:ui": "playwright test --ui",
    "test:debug": "cucumber-js --publish",
    "test:report": "allure serve reports/allure-results",
    "clean:reports": "rimraf reports/allure-results",
    "pretest": "npm run clean:reports"
  },
  "keywords": [
    "playwright",
    "typescript",
    "cucumber",
    "bdd",
    "automation",
    "testing"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@cucumber/cucumber": "^10.3.1",
    "@playwright/test": "^1.43.1",
    "@types/node": "^18.19.31",
    "@cucumber/pretty-formatter": "^1.0.0",
    "allure-commandline": "^2.25.0",
    "allure-playwright": "^2.9.0",
    "dotenv": "^16.4.5",
    "rimraf": "^5.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "axios": "^1.6.0"
  }
}
