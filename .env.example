# Base configuration
BASE_URL=https://demoqa.com
ENVIRONMENT=dev

# Browser configuration
HEADLESS=false
BROWSER=chromium
VIEWPORT_WIDTH=1280
VIEWPORT_HEIGHT=720

# Debug Mode Configuration
# Slow down browser actions (in milliseconds) - useful for debugging
# 0 = no delay, 1000 = 1 second delay between actions
SLOW_MO=0

# Enable step-by-step debugging mode (automatically enables DevTools)
DEBUG_STEP=false

# Test configuration
# Timeouts are set higher to handle DemoQA's ad-heavy pages
DEFAULT_TIMEOUT=60000
ACTION_TIMEOUT=30000
NAVIGATION_TIMEOUT=60000

# Parallel execution
WORKERS=1
RETRIES=0

# CI Configuration (override in CI environment)
CI_HEADLESS=true
CI_WORKERS=2
CI_RETRIES=2

# Logging configuration
LOG_LEVEL=info
LOG_TO_FILE=true
LOG_FILE_PATH=logs/test-execution.log

# Reporting configuration
ALLURE_RESULTS_DIR=reports/allure-results
SERENITY_OUTPUT_DIR=reports/serenity

# Database configuration (if needed)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=testdb
# DB_USER=testuser
# DB_PASSWORD=testpass

# API configuration (if needed)
# API_BASE_URL=https://api.demoqa.com
# API_TIMEOUT=10000
# API_KEY=your-api-key

# Test data configuration
TEST_DATA_PATH=src/test-data
SCREENSHOTS_PATH=reports/screenshots
DOWNLOADS_PATH=test-results/downloads